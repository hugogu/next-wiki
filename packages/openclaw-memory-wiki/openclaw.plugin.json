{
  "id": "next-wiki-memory-wiki",
  "name": "next-wiki Memory Wiki",
  "description": "Mirror OpenClaw Memory Wiki Markdown into next-wiki and retrieve the account knowledge base.",
  "version": "0.1.0",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string", "format": "uri", "description": "next-wiki origin (HTTPS or loopback HTTP)" },
      "mirrorApiKeyRef": {
        "description": "OpenClaw SecretRef for the mirror key",
        "anyOf": [
          { "type": "string" },
          { "type": "object", "additionalProperties": false, "properties": { "source": { "enum": ["env", "file", "exec"] }, "provider": { "type": "string" }, "id": { "type": "string" } }, "required": ["source", "provider", "id"] }
        ]
      },
      "knowledgeApiKeyRef": {
        "description": "OpenClaw SecretRef for the knowledge-search key",
        "anyOf": [
          { "type": "string" },
          { "type": "object", "additionalProperties": false, "properties": { "source": { "enum": ["env", "file", "exec"] }, "provider": { "type": "string" }, "id": { "type": "string" } }, "required": ["source", "provider", "id"] }
        ]
      },
      "vaultPath": { "type": "string", "description": "Memory Wiki vault directory" },
      "syncIntervalMinutes": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 5 },
      "enabled": { "type": "boolean", "default": true }
    },
    "required": ["baseUrl", "mirrorApiKeyRef", "knowledgeApiKeyRef", "vaultPath"]
  },
  "uiHints": {
    "mirrorApiKeyRef": { "sensitive": true, "label": "Mirror API key SecretRef" },
    "knowledgeApiKeyRef": { "sensitive": true, "label": "Knowledge search API key SecretRef" }
  },
  "skills": ["./skills"],
  "contracts": { "tools": ["next_wiki_status", "next_wiki_sync", "next_wiki_search", "next_wiki_get"] },
  "toolMetadata": {
    "next_wiki_status": { "replaySafe": true },
    "next_wiki_sync": { "optional": true },
    "next_wiki_search": { "replaySafe": true },
    "next_wiki_get": { "replaySafe": true }
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        { "path": "mirrorApiKeyRef", "expected": "string" },
        { "path": "knowledgeApiKeyRef", "expected": "string" }
      ]
    }
  }
}
