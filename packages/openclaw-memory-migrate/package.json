{
  "name": "@next-wiki/openclaw-memory-migrate",
  "version": "0.1.0",
  "description": "One-time previewable migration utility for OpenClaw memory into next-wiki",
  "type": "module",
  "files": ["dist", "openclaw.plugin.json", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": { "build": "tsc", "typecheck": "tsc --noEmit", "test": "vitest run" },
  "engines": { "node": ">=22.22.3" },
  "peerDependencies": { "openclaw": ">=0.1.0" },
  "peerDependenciesMeta": { "openclaw": { "optional": true } },
  "dependencies": { "zod": "^3.24.1" },
  "devDependencies": { "@types/node": "^22.10.0", "typescript": "^5.6.3", "vitest": "^3.0.0" }
}
